# ==============================================================================
# Resale Listing Pipeline Configuration (.env_example)
# Copy this file to `.env` and fill in your personal settings (or let your
# Antigravity / Claude Code agent interview you during setup).
# ==============================================================================

# --- Location & Shipping Settings ---
# Your origin 5-digit ZIP code (used for Zone 8 shipping math & local pickup fields)
ORIGIN_ZIP=90210

# Your local Craigslist subdomain (extracted from https://<subdomain>.craigslist.org)
# Examples: sfbay, seattle, losangeles, chicago, newyork, austin
CRAIGSLIST_SUBDOMAIN=losangeles

# Optional Craigslist sub-area and city/neighborhood (used by multi-region sites like sfbay or losangeles)
# Leave blank if your local Craigslist goes straight to "choose a type of posting"
CRAIGSLIST_AREA=
CRAIGSLIST_CITY=

# --- Stage 1: Photo Slicing Thresholds ---
# Maximum seconds between consecutive photos before starting a new item folder
PHOTO_TIME_GAP_SECONDS=60
# Maximum photo count in a folder to flag as a potential outlier needing visual merge check
OUTLIER_MAX_PHOTOS=2

# --- Stage 2: Fee, Profit & Routing Thresholds ---
# eBay Final Value Fee percentage (default 13.5% = 0.135) and per-order fixed fee ($0.40)
EBAY_FEE_PERCENT=0.135
EBAY_FIXED_FEE=0.40

# Facebook Marketplace price markup buffer for local negotiation (e.g., 0.12 = +12%)
FBMP_NEGOTIATION_BUFFER=0.12

# Routing Bucket Thresholds (USD / lbs / inches)
MIN_PROFIT_ALL_THREE=40.00
MIN_PROFIT_EBAY_ONLY=10.00
MIN_COMP_LOCAL_ONLY=20.00
LOCAL_ONLY_MAX_WEIGHT_LBS=25.0
LOCAL_ONLY_MAX_SIDE_IN=24.0
LOCAL_ONLY_MAX_SHIPPING_RATIO=0.40

# Priority Scoring Normalization Cap ($200+ comp price = 100 value score)
VALUE_SCORE_CAP_DOLLARS=200.0

# --- Stage 2 Fallback Vision API (Optional) ---
# By default, Antigravity / Claude uses native agent vision ($0 API cost).
# Set GEMINI_API_KEY only if running `python scripts/analyze_items.py --use-api` standalone.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Stage 4: Playwright Chrome CDP Settings ---
CHROME_CDP_URL=http://localhost:9222
CHROME_CDP_PORT=9222
CHROME_PROFILE_DIR=./chrome_profile

# --- Stage 5: Google Sheets & Drive Backup Settings (Optional) ---
# Path to your Google Cloud Service Account JSON key
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service_account.json
# The Spreadsheet ID from your Google Sheet URL: https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
GOOGLE_SHEET_ID=YOUR_GOOGLE_SHEET_ID_HERE
GOOGLE_WORKSHEET_NAME=Listings
# Optional Google Drive folder/file IDs for backing up your private .env
GOOGLE_DRIVE_BACKUP_FOLDER_ID=
GOOGLE_DRIVE_ENV_FILE_ID=
